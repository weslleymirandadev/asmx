; ----------------------------------------------------------------------
; SSR + hydration (ui/ssr.asm): the shell embeds the FULL rendered HTML
; (server-rendered widget tree) with stable ids + a first-render checksum
; + the state snapshot. The glue hydrates this DOM instead of rebuilding.
; ----------------------------------------------------------------------
s_ssr_div1  db '<div id="ui" data-asx-root="', 0
s_ssr_ck1   db '" data-asx-checksum="', 0
s_ssr_mod1  db '" data-modules="/', 0
s_ssr_sufi  db '.wasm">', 0
s_ssr_sufp  db '/page.wasm">', 0
s_ssr_close db '</div>', 0
; dynamic tag open/close: '<' + tag_name + ' data-asx-id="' + id +
; [role] + [attrs] + ' style="' + css + '">' | '</' + tag_name + '>'
s_ssr_lt     db '<', 0
s_ssr_ida    db ' data-asx-id="', 0
s_ssr_idc    db '"', 0
s_ssr_role   db ' data-asx-role="button"', 0
s_ssr_sty    db ' style="', 0
s_ssr_gt     db '">', 0
s_ssr_close2 db '</', 0
s_ssr_close3 db '>', 0
s_ssr_snap1 db '<script type="application/asx-state">{"root":"', 0
;   db '...{"root":"<ui>', 34, 4, '}</script>'
; so the final bytes are: " 0x04 }</script> (the server injects the
; ,"key":value pairs at the 0x04 injection point; the " (34) closes
; the root value so the JSON stays valid)
s_ssr_snap2 db "', 34, 4, '}</script>", 0
; ssr.state substitution slots (bytes of control the server resolves):
;   text slot: 0x01 <state name> 0x02 <default value> 0x03
;   snapshot:  0x04 = injection point for the ,"key":value pairs
s_ssr_slot1 db "', 1, '", 0
s_ssr_slot2 db "', 2, '", 0
s_ssr_slot3 db "', 3, '", 0
; global base css served WITH the SSR shell so the first paint already
; has the reset + theme (no layout flicker when the glue boots later);
; the glue skips injecting its own copy when this tag is present
s_ssr_sty1  db '<style data-asx-base>*{margin:0;padding:0;box-sizing:border-box}button{border:none;background:none;font:inherit}body{min-height:100vh;font-family:ui-sans-serif,system-ui,sans-serif;padding:48px 24px;background:#', 0

