; =============================================================================
; literals.inc - error messages and output literals
; =============================================================================

; dados
; ----------------------------------------------------------------------
section .data

; --- mensagens de erro ---
msg_usage     db "ui-compile: uso: ui-compile <src.s> <out.s>", 10
msg_usage_len equ $ - msg_usage
msg_read      db "ui-compile: cannot read file", 10
msg_read_len  equ $ - msg_read
msg_big       db "ui-compile: input file too big (>64KB)", 10
msg_big_len   equ $ - msg_big
msg_big_out   db "ui-compile: output too big (>128KB)", 10
msg_big_out_len equ $ - msg_big_out
msg_write     db "ui-compile: cannot write file", 10
msg_write_len equ $ - msg_write
msg_block     db "ui-compile: invalid line in @ block", 10
msg_block_len equ $ - msg_block
msg_text      db "ui-compile: text with no open tag (or duplicate)", 10
msg_text_len  equ $ - msg_text
msg_nodes     db "ui-compile: muitos nos (>64)", 10
msg_nodes_len equ $ - msg_nodes
msg_depth     db "ui-compile: profundidade maxima (32)", 10
msg_depth_len equ $ - msg_depth
msg_blob      db "ui-compile: blob too big (>8KB)", 10
msg_blob_len  equ $ - msg_blob
msg_tag       db "ui-compile: unknown tag: ", 0
msg_tag_len   equ $ - msg_tag - 1        ; without the null (token follows)
msg_nl        db 10, 0

; --- literais do output (shell no page.s + WAT) ---
s_sh1         db "_shell: db ", 0
s_sh2         db '<div id="ui" data-modules="/', 0
s_sh3         db '/page.wasm"></div>', 0
s_sh3i        db '.wasm"></div>', 0
s_sh4         db ", 10", 10, 0
s_sh5         db "          db ", 0
s_sh6         db '<script type="module" src="/_asmx/glue.js"></script>', 0
s_sh7         db ", 0", 10, 0
s_wat_h1      db ";; componente ", 0
s_wat_h2      db " - generated by asmx/ui/compile.asm", 10, 0
s_wat_fn1     db "(func $c_", 0
s_wat_fn2     db 10, 0
s_wat_loc1    db "  (local $v", 0
s_wat_loc2    db " i32)", 10, 0
s_wat_i32     db "  i32.const ", 0
s_wat_lget    db "  local.get $v", 0
s_wat_m1      db "  i32.const -1", 10, 0
s_wat_view    db "  call $view", 10, "  local.set $v", 0
s_wat_lbl     db "  call $label", 10, "  drop", 10, 0
s_wat_close   db ")", 10, 0
s_wat_d1      db "(data (i32.const ", 0
s_wat_d2      db ') "', 0
s_wat_d3      db '\00")', 10, 0
s_wat_bs      db '\', 0
s_main_h1     db ";; page ", 0
s_main_h2     db " - generated by asmx/ui/compile.asm", 10
              db '(memory (export "memory") 3)', 10
              db "(global $w i32 (i32.const 720))", 10
              db "(global $h i32 (i32.const 720))", 10
              db '(func (export "render")', 10
              db "  i32.const 0", 10, "  global.set $ui_dirty", 10
              db "  call $ui_reset", 10, 0
s_main_call   db "  call $c_", 0
s_main_t1     db ")", 10, '(func (export "ui_theme_bg") (result i32) i32.const 0x', 0
s_main_t2     db ")", 10, '(func (export "ui_theme_text") (result i32) i32.const 0x', 0
s_main_t3     db ")", 10, '(func (export "ui_theme_accent") (result i32) i32.const 0x', 0
s_main_t4     db ")", 10
              db '(func (export "widgets") (result i32) global.get $widget_base)', 10
              db '(func (export "widget_count") (result i32) global.get $widget_count)', 10
              db '(func (export "ui_dirty") (result i32) global.get $ui_dirty)', 10, 0
s_dot_d       db ".d/", 0
s_dot_d_dir   db ".d", 0
s_dot_wat     db ".wat", 0
s_wat_q       db '\"', 0
s_main_wat    db "_main.wat", 0

s_nl2         db 10, 0

; --- tokens internos ---
s_end         db "end", 0
s_theme       db "theme", 0
s_key_bg      db "bg", 0
s_key_text    db "text", 0
s_key_accent  db "accent", 0
s_bg          db "bg-", 0
s_text        db "text-", 0
s_p           db "p-", 0
s_mt          db "mt-", 0
