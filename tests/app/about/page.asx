; tests/app/about/page.s - the /about route (SPA navigation target).
; Distinct content from the home page so the SPA test can assert the
; DOM actually swapped to a DIFFERENT module/tree.

section .data
    about_content:
        @theme bg #0b1020 text #eef2ff accent #8b5cf6
        @main min-h-screen p-8
            @h1 text-3xl font-bold:
                "About Page"
            @p mt-4 text-violet-300:
                "This is the /about route - SPA-navigated."
            @a href="/" text-blue-400 underline mt-8:
                "Back to home"
        @end

page get_about

section .SERVER
get_about:
    res.content about_content
    asx.next
