; tests/app/contact/page.asx - the /contact route (hover-prefetch target).
; NEVER visited in the SPA test until the hover->click case: proves that a
; hovered link navigates with zero network (shell + wasm bytes cached).

section .data
    contact_content:
        @theme bg #0b1020 text #eef2ff accent #8b5cf6
        @main min-h-screen p-8
            @h1 text-3xl font-bold:
                "Contact Page"
            @p mt-4 text-violet-300:
                "This is the /contact route - prefetched on hover, zero network on click."
            @a href="/" text-blue-400 underline mt-8:
                "Back to home"
        @end

page get_contact

section .SERVER
get_contact:
    res.content contact_content
    asx.next
